# Copy to .env and adjust. .env is git-ignored and must never be committed.
# Every value below is optional for local development: the defaults already match.

# --- Local PostgreSQL (compose.yaml) ---
POSTGRES_DB=invoiceflow
POSTGRES_USER=invoiceflow
POSTGRES_PASSWORD=invoiceflow
POSTGRES_PORT=5432

# --- Backend datasource (read by Spring Boot from the environment) ---
# dev profile: defaults point to the local PostgreSQL above.
# prod profile: required, no defaults (set them in the hosting platform, not in a file).
DB_URL=jdbc:postgresql://localhost:5432/invoiceflow
DB_USERNAME=invoiceflow
DB_PASSWORD=invoiceflow
