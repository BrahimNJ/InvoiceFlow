{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs 4200",
      "startServerReadyPattern": "Serving",
      "url": ["http://localhost:4200/", "http://localhost:4200/docs/overview", "http://localhost:4200/login"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4200/(login)?$",
          "assertions": {
            "resource-summary:script:size": ["error", { "maxNumericValue": 160000 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 270000 }]
          }
        },
        {
          "matchingUrlPattern": "/docs/",
          "assertions": {
            "resource-summary:script:size": ["error", { "maxNumericValue": 850000 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 960000 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
