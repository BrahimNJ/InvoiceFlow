{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "docs": "node scripts/build-docs.mjs",
    "prestart": "npm run docs",
    "start": "ng serve",
    "prebuild": "npm run docs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --configuration coverage",
    "prebuild:e2e": "npm run docs",
    "build:e2e": "ng build --configuration production,e2e",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "mermaid": "12.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "4.1.11",
    "github-slugger": "2.0.0",
    "jsdom": "^28.0.0",
    "marked": "18.1.0",
    "prettier": "^3.8.1",
    "shiki": "4.5.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
